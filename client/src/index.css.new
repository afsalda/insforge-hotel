@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ═══════════════════════════════════════════════════
   AL BAITH — Design System
   Arabic/Islamic Luxury × Modern Biophilic Design
   ═══════════════════════════════════════════════════ */

@font-face {
  font-family: 'Balkind';
  src: url('/fonts/Balkind.woff2') format('woff2'),
    url('/fonts/Balkind.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'ZeistN2Web';
  src: url('/fonts/ZeistN2Web-Regular.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'InterNumbers';
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  unicode-range: U+0030-0039, U+002C, U+002E, U+002D;
  src: local('Inter'), local('Inter Regular'), local('Inter-Regular'), sans-serif;
}

:root {
  --bg-deep-green: #1A2E1A;
  --bg-cream: #F5F0E8;
  --bg-off-white: #FAF8F4;
  --accent-gold: #C9A96E;
  --accent-gold-bright: #DBBF8A;
  --accent-gold-dim: #A08550;
  --card-dark: rgba(10, 25, 10, 0.75);
  --card-glass: rgba(255, 255, 255, 0.08);
  --text-cream: #F5F0E8;
  --text-charcoal: #1C1C1C;
  --text-muted: #7A7A6E;
  --gold-border: rgba(201, 169, 110, 0.3);
  --gold-border-bright: rgba(201, 169, 110, 0.6);
  --radius-card: 20px;
  --radius-pill: 50px;
  --shadow-soft: 0 8px 32px rgba(0, 0, 0, 0.12);
  --shadow-gold: 0 4px 24px rgba(201, 169, 110, 0.15);
  --font-heading: 'InterNumbers', 'Balkind', serif;
  --font-body: 'InterNumbers', 'ZeistN2Web', sans-serif;
  --font-arabic: 'Scheherazade New', serif;
  --transition-smooth: cubic-bezier(0.4, 0, 0.2, 1);
  --backdrop-blur: blur(16px);
  --primary: var(--bg-deep-green);
  --primary-light: #2A422A;
  --primary-dark: #0F1D0F;
  --accent: var(--accent-gold);
}

/* ── Premium Animations ── */
@keyframes gold-glow {
  0%, 100% { filter: drop-shadow(0 0 5px rgba(201, 169, 110, 0.4)); }
  50% { filter: drop-shadow(0 0 15px rgba(201, 169, 110, 0.8)); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes scroll-bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-10px); }
  60% { transform: translateY(-5px); }
}

.animate-gold-glow {
  animation: gold-glow 3s infinite ease-in-out;
}

.animate-float {
  animation: float 4s infinite ease-in-out;
}

.scroll-indicator {
  animation: scroll-bounce 2s infinite;
}

* {
  font-family: 'InterNumbers', inherit;
  text-rendering: optimizeLegibility;
}
