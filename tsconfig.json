{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "outDir": ".vercel/output",
        "rootDir": ".",
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["api/**/*.ts"],
    "exclude": ["node_modules", "client"]
}
