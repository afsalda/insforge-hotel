{
    "name": "staybnb",
    "version": "1.0.0",
    "private": true,
    "description": "Full-stack Airbnb clone — vacation rental marketplace",
    "workspaces": [
        "packages/shared",
        "client",
        "server"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
        "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:server\" \"npm run dev:client\"",
        "dev:client": "npm run dev --workspace=client",
        "dev:server": "npm run dev --workspace=server",
        "dev:api": "tsx dev-api-server.mjs",
        "build": "npm run build --workspace=client",
        "seed": "npm run seed --workspace=server",
        "lint": "concurrently \"npm run lint --workspace=client\" \"npm run lint --workspace=server\""
    },
    "devDependencies": {
        "@vercel/node": "^5.6.9",
        "autoprefixer": "10.4.27",
        "concurrently": "^8.2.2",
        "postcss": "8.5.8",
        "sharp": "^0.34.5",
        "tailwindcss": "3.4.17",
        "tsx": "^4.21.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "framer-motion": "^12.38.0",
        "gsap": "^3.14.2",
        "lenis": "^1.3.21",
        "react-helmet-async": "^3.0.0",
        "razorpay": "^2.9.6",
        "@insforge/sdk": "^1.1.5"
    }
}
